Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "(\.sql|\.ps1|\.md|\.env|\.json|\.yml)$">
    Require all denied
</FilesMatch>

# Repository tooling is not part of the PHP site
RedirectMatch 404 /(tests|scripts|guides|node_modules|\.github)(/|$)
